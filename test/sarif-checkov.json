{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Checkov",
          "rules": [
            {
              "id": "CKV_AWS_21",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "5.0"
              }
            },
            {
              "id": "CKV_AWS_18",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "3.0"
              }
            },
            {
              "id": "CKV2_AWS_6",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "7.4"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CKV_AWS_21",
          "level": "error",
          "message": {
            "text": "Ensure all data stored in the S3 bucket have versioning enabled"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "s3.tf"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "CKV_AWS_18",
          "level": "error",
          "message": {
            "text": "Ensure the S3 bucket has access logging enabled"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "s3.tf"
                },
                "region": {
                  "startLine": 9
                }
              }
            }
          ]
        },
        {
          "ruleId": "CKV2_AWS_6",
          "level": "warning",
          "message": {
            "text": "Ensure that S3 bucket has a Public Access block"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "s3.tf"
                },
                "region": {
                  "startLine": 20
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
